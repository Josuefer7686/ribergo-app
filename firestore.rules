rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Perfiles de Usuarios (Pasajeros y Conductores)
    match /users/{userId} {
      allow read, write: if true;
    }

    // Casillero de Ingresos y Métricas del Conductor
    match /driver_boxes/{driverId} {
      allow read, write: if true;
    }

    // Solicitudes de Recarga de Saldo por QR y Bot de Telegram
    match /wallet_recharges/{rechargeId} {
      allow read, write: if true;
    }

    // Configuración del Sistema (Admin Telegram Bot, etc.)
    match /system_config/{configId} {
      allow read, write: if true;
    }

    // Solicitudes activas en tiempo real
    match /active_requests/{requestId} {
      allow read, write, delete: if true;
    }

    // Carreras y solicitudes de viaje
    match /rides/{rideId} {
      allow read, write, delete: if true;
    }

    // Chat en tiempo real durante el viaje (subcolecciones)
    match /rides/{rideId}/messages/{messageId} {
      allow read, write: if true;
    }
    match /rides/{rideId}/chat/{messageId} {
      allow read, write: if true;
    }

    // Conductores en línea (GPS y disponibilidad en el mapa)
    match /online_drivers/{driverId} {
      allow read, write: if true;
    }

    // Historial forense y de viajes completados
    match /tripsHistory/{tripId} {
      allow read, write: if true;
    }
    match /trips_history/{tripId} {
      allow read, write: if true;
    }

    // Terminal Interprovincial (Salidas, Boletos, Expresos y Encomiendas)
    match /terminal_departures/{departureId} {
      allow read, write: if true;
    }
    match /terminal_bookings/{bookingId} {
      allow read, write: if true;
    }
    match /terminal_expresos/{expresoId} {
      allow read, write: if true;
    }
    match /terminal_encomiendas/{encomiendaId} {
      allow read, write: if true;
    }

    // Regla comodín para cualquier otra colección actual o futura
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
