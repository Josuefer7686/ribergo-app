# =================================================================
# RIBERGO WEB APP — VERCEL & ENVIRONMENT CONFIGURATION EXAMPLE
# =================================================================
# Copy these environment variables into your Vercel Project Settings:
# Settings -> Environment Variables

# Firebase Client Configuration (Real RiberGO Firebase Instance)
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSy..."
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="ribergo-app.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="ribergo-app"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="ribergo-app.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="839601162337"
NEXT_PUBLIC_FIREBASE_APP_ID="1:839601162337:web:32c1900ca7b30c21728220"

# Optional Gemini AI API Key (if AI Studio integration is used)
# GEMINI_API_KEY="your_gemini_api_key_here"

# Telegram (recargas de billetera). NUNCA pongas valores reales en este archivo.
# Token del bot: se obtiene en @BotFather. Si se filtra, revócalo con /revoke.
TELEGRAM_BOT_TOKEN="123456789:AA...tu_token_aqui"
# ID numérico de tu usuario de Telegram (el bot te lo muestra al escribirle /start)
TELEGRAM_ADMIN_CHAT_ID="123456789"
# Cadena larga aleatoria (32+ caracteres); se registra con secret_token en setWebhook
TELEGRAM_WEBHOOK_SECRET="cambia-esto-por-una-cadena-aleatoria-larga"

# Firebase Admin (SOLO servidor). JSON de la cuenta de servicio codificado en base64:
#   base64 -w0 ruta/al/archivo.json
FIREBASE_SERVICE_ACCOUNT_B64=""

# Panel de administración (/admin). Elige una contraseña larga y un secreto aleatorio:
#   openssl rand -hex 32
ADMIN_PANEL_PASSWORD=""
ADMIN_SESSION_SECRET=""

# Limpieza diaria automática (Vercel Cron). Cadena aleatoria de 16+ caracteres:
CRON_SECRET=""
